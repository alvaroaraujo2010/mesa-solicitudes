PORT=3000
NODE_ENV=development

# ============================================================
# Adaptador de persistencia
# Descomenta UN solo bloque y comenta los demás.
# ============================================================

# --- memory -------------------------------------------------
# PERSISTENCE_ADAPTER=memory

# --- mysql (MySQL80 local, puerto 3306) ---------------------
PERSISTENCE_ADAPTER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=administrador
MYSQL_PASSWORD=cambia_este_password
MYSQL_DATABASE=mesa_solicitudes
MYSQL_POOL_SIZE=10

# --- mysql portable alternativo (puerto 3307) ---------------
# PERSISTENCE_ADAPTER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=mesa
# MYSQL_PASSWORD=mesa_secret
# MYSQL_DATABASE=mesa_solicitudes
# MYSQL_POOL_SIZE=10

# --- dynamodb local -----------------------------------------
# PERSISTENCE_ADAPTER=dynamodb
# DYNAMODB_TABLE_NAME=mesa-solicitudes
# DYNAMODB_REGION=us-east-1
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
